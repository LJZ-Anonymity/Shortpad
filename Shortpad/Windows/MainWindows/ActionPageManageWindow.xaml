<Window
    xmlns:styles="clr-namespace:Shortpad.UI.Styles.Button;assembly=Shortpad.UI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="clr-namespace:Shortpad.UI.Converters;assembly=Shortpad.UI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    x:Class="Shortpad.Windows.MainWindows.ActionPageManageWindow"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Shortpad.Windows.MainWindows"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    mc:Ignorable="d"

    WindowStartupLocation="CenterScreen"
    Title="场景与动作管理"
    Height="850"
    Width="1200"
>
    <Window.Resources>
        <conv:SearchHintVisibilityConverter x:Key="SearchHintVisibilityConverter"/>
        <Style x:Key="UniformGrid" TargetType="UniformGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0,20,0,0"/>
        </Style>
        <!-- 动作页标题网格 -->
        <Style x:Key="ActionPageTitleGrid" TargetType="Grid">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Width" Value="260"/>
        </Style>
        <!-- 场景按钮的内容网格 -->
        <Style x:Key="SceneButtonContentGrid" TargetType="Grid">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Width" Value="221"/>
        </Style>
        <Style x:Key="SceneButton" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CheckedSceneButtonBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverSceneButtonBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CheckedHoverSceneButtonBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Label Content="筛选..." Foreground="#FFABADB3" Visibility="{Binding ElementName=SearchTextBox, Path=Text, Converter={StaticResource SearchHintVisibilityConverter}}" HorizontalAlignment="Left" Margin="12,11,0,0" VerticalAlignment="Top"/>
        <TextBox x:Name="SearchTextBox" Style="{StaticResource RoundedTextBox}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="9,10,0,0" TextWrapping="Wrap" Width="221" Height="28" TextChanged="SearchTextBox_TextChanged"/>
        <Button x:Name="ClearSearchTextBoxButton" HorizontalAlignment="Left" VerticalAlignment="Top" Width="16" Height="16" Margin="207,16,0,0" Click="ClearSearchTextBoxButton_Click">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource ClearSearchTextBoxButton}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, ElementName=SearchTextBox}" Value="True"/>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible"/>
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>
        <Border Margin="9,44,0,39" CornerRadius="4" HorizontalAlignment="Left" Width="221" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
            <StackPanel x:Name="ActionPagesButtonPanel"/>
        </Border>
        <Button x:Name="AddSceneButton" Style="{StaticResource BaseRoundedButton}" styles:ButtonHelper.CornerRadius="5,0,0,5" ToolTip="添加场景" HorizontalAlignment="Left" Margin="10,0,0,10" VerticalAlignment="Bottom" Width="50" Click="AddSceneButton_Click">
            <Image Source="/Resources/Images/button_add_scene.png" Height="16" Width="16"/>
        </Button>
        <Button x:Name="EditSceneButton" Style="{StaticResource BaseRoundedButton}" styles:ButtonHelper.CornerRadius="0" ToolTip="修改场景设置" HorizontalAlignment="Left" Margin="59,0,0,10" VerticalAlignment="Bottom" Width="50" Click="EditSceneButton_Click">
            <Image Source="/Resources/Images/button_edit_scene.png" Height="16" Width="16"/>
        </Button>
        <Button x:Name="DeleteSceneButton" Style="{StaticResource BaseRoundedButton}" styles:ButtonHelper.CornerRadius="0,5,5,0" ToolTip="删除场景" HorizontalAlignment="Left" Margin="108,0,0,10" VerticalAlignment="Bottom" Width="50" Click="DeleteSceneButton_Click">
            <Image Source="/Resources/Images/button_delete_scene.png" Height="16" Width="16"/>
        </Button>
        <Button x:Name="ToTopSceneButton" Style="{StaticResource WhiteButton}" ToolTip="到顶部" HorizontalAlignment="Left" Margin="200,0,0,10" VerticalAlignment="Bottom" Width="30" Click="ToTopSceneButton_Click">
            <Image Source="/Resources/Images/button_jump_to_pinned.png" Height="16" Width="16"/>
        </Button>

        <Image x:Name="SceneImage" HorizontalAlignment="Left" Height="16" Margin="240,10,0,0" VerticalAlignment="Top" Width="16"/>
        <StackPanel x:Name="SceneTitleStackPanel" Margin="262,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Height="18" Orientation="Horizontal"/>
        <Label Content="提示：将窗口最大化可以方便排序动作页。" Foreground="#FFB4B4B4" Margin="0,5,-3,0" VerticalAlignment="Top" FontSize="11" HorizontalAlignment="Right" Width="229" MouseDoubleClick="ChangeActionButtonBakground">
            <Label.ToolTip>
                <ToolTip Content="双击这里：将按钮背景色改为灰色" Foreground="Black"/>
            </Label.ToolTip>
        </Label>

        <Border x:Name="MainBorder" Margin="239,31,11,0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0.75" VerticalAlignment="Top" Height="224">
            <ScrollViewer x:Name="ScrollViewer" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" ScrollChanged="ScrollViewer_ScrollChanged">
                <ListView x:Name="MainListView" Background="{DynamicResource MenuGridBrush}" AllowDrop="True" PreviewDragOver="ListView_PreviewDragOver" Drop="ListView_Drop" MouseWheel="MainStackPanel_MouseWheel">
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel x:Name="MainStackPanel" Orientation="Horizontal" MouseWheel="MainStackPanel_MouseWheel"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>

                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Margin" Value="2,0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListViewItem">
                                        <Border Background="{TemplateBinding Background}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>
            </ScrollViewer>
        </Border>
        <ScrollBar x:Name="ScrollBar" Margin="240,250,10,0" VerticalAlignment="Top" Orientation="Horizontal" ValueChanged="ScrollBar_ValueChanged"/>
        <Popup x:Name="EditActionPagePopup" PopupAnimation="Fade" Height="137" Width="180" AllowsTransparency="True" StaysOpen="False">
            <Grid>
                <Rectangle Fill="{DynamicResource SliderBrush}" Margin="3,5">
                    <Rectangle.Effect>
                        <DropShadowEffect Color="{DynamicResource ShadowEffectBrush}" Direction="0" BlurRadius="8" RenderingBias="Quality" ShadowDepth="1"/>
                    </Rectangle.Effect>
                </Rectangle>
                <Border Background="{DynamicResource PopupSurfaceBrush}" BorderThickness="0" CornerRadius="3" Margin="3">
                    <StackPanel Background="{x:Null}">
                        <Button x:Name="CheckActionPageInfoButton" Style="{StaticResource MenuButton}" ToolTip="查看动作页信息" Margin="0,3,0,0" Click="CheckActionPageInfoButton_Click">
                            <Grid>
                                <Image Source="/Resources/Images/icon_info.png" Style="{StaticResource SelectButtonImage}"/>
                                <TextBlock Text="信息" TextAlignment="Left" VerticalAlignment="Center" Margin="26,0,0,0" FontSize="13"/>
                            </Grid>
                        </Button>
                        <Button x:Name="CopyActionPageIDButton" Style="{StaticResource MenuButton}" ToolTip="复制动作页ID" Click="CopyActionPageIDButton_Click">
                            <Grid>
                                <Image Source="/Resources/Images/action_copy.png" Style="{StaticResource SelectButtonImage}"/>
                                <TextBlock Text="复制ID" TextAlignment="Left" Margin="26,0,0,0" FontSize="13"/>
                            </Grid>
                        </Button>
                        <Button x:Name="EditActionPageInfoButton" Style="{StaticResource MenuButton}" ToolTip="编辑动作页信息" Click="EditActionPageInfoButton_Click">
                            <Grid>
                                <Image Source="/Resources/Images/button_edit_scene.png" Style="{StaticResource SelectButtonImage}"/>
                                <TextBlock Text="编辑" TextAlignment="Left" Margin="26,0,0,0" FontSize="13"/>
                            </Grid>
                        </Button>
                        <Button x:Name="CreatOpenActionPageActionButton" Style="{StaticResource MenuButton}" ToolTip="创建一个切换到此动作页的动作并复制到剪贴板" Click="CreatOpenActionPageActionButton_Click">
                            <Grid>
                                <Image Source="/Resources/Images/action_paste.png" Style="{StaticResource SelectButtonImage}"/>
                                <TextBlock Text="生成加载动作页的动作" TextAlignment="Left" Margin="26,0,0,0" FontSize="13"/>
                            </Grid>
                        </Button>
                        <Button x:Name="DeleteActionPageButton" Style="{StaticResource MenuButton}" ToolTip="删除动作页" Click="DeleteActionPageButton_Click">
                            <Grid>
                                <Image Source="/Resources/Images/button_close.png" Style="{StaticResource SelectButtonImage}"/>
                                <TextBlock Text="删除动作页" TextAlignment="Left" Margin="26,0,0,0" FontSize="13"/>
                            </Grid>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Popup>
        <Button x:Name="AddActionPageButton" Content="添加动作页" Style="{StaticResource WhiteButton}" HorizontalAlignment="Left" Margin="240,264,0,0" VerticalAlignment="Top" Click="AddActionPage" Width="163" ToolTip="右键显示/隐藏动作使用次数" MouseRightButtonDown="AddActionPageButton_MouseRightButtonDown"/>
        <CheckBox x:Name="AutoReturnToFirstPageCheckBox" Content="自动返回第一页" Margin="535,268,0,0" VerticalAlignment="Top" ToolTip="在后面的页执行完动作后是否自动返回到第一页" HorizontalAlignment="Left" Click="AutoReturnToFirstPageCheckBox_Click"/>
    </Grid>
</Window>