<Window
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:conv="clr-namespace:Shortpad.UI.Converters;assembly=Shortpad.UI"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Shortpad.Windows.MainWindows"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    x:Class="Shortpad.Windows.MainWindows.FindAppsWindow"
    xmlns:helpers="clr-namespace:Shortpad.Helpers"
    mc:Ignorable="d"

    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    Title="选择应用程序"
    Height="450"
    Width="500"

    ContentRendered="LoadApplications"
>
    <Window.Resources>
        <conv:HighlightTextConverter x:Key="HighlightTextConverter"/>
        <Style x:Key="LeftAlignedHeader" TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridViewColumnHeader">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                            </Border>
                            <Canvas>
                                <Thumb x:Name="PART_HeaderGripper" Canvas.Right="-9" Width="18" Height="{Binding ActualHeight, RelativeSource={RelativeSource TemplatedParent}}" Background="Transparent">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent">
                                                <Rectangle HorizontalAlignment="Center" Width="1" Fill="{DynamicResource ListHeaderHoverBrush}"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Canvas>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListHeaderHoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Role" Value="Padding">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="GridViewColumnHeader">
                                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <TextBox x:Name="SearchTextBox" Style="{StaticResource RoundedTextBox}" TextWrapping="Wrap" Width="150" Height="27" Margin="13,17,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="13" TextChanged="SearchTextBox_TextChanged"/>
        <Button Style="{StaticResource WhiteButton}" Content="搜索" Margin="168,17,0,0" Click="SearchButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Width="48" Height="27"/>
        <Button Style="{StaticResource WhiteButton}" Content="刷新" Margin="242,17,0,0" Click="RefreshButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Width="50" Height="27"/>
        <Button Style="{StaticResource WhiteButton}" Content="浏览..." Margin="305,17,0,0" Click="BrowseButton_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Width="55" Height="27"/>
        <Button x:Name="SelectWindowButton" Style="{StaticResource WhiteButton}" Margin="382.5,17,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Width="86" Height="27" Click="SelectWindowButton_Click">
            <Grid Width="76">
                <TextBlock Text="选择窗口" Margin="23,0,0,0"/>
                <Image Source="/Resources/Images/pick_window.png" Margin="5,0,56,0" Width="15" Height="15"/>
            </Grid>
        </Button>
        <Grid  Margin="13,49,11,42" MouseEnter="ShowScrollBar" MouseLeave="HideScrollBar">
            <ListView x:Name="ApplicationsListView" SelectionMode="Single" BorderBrush="{DynamicResource BorderBrush}" SelectionChanged="ApplicationsListView_SelectionChanged" Background="{x:Null}" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Hidden" ScrollViewer.CanContentScroll="False" MouseDoubleClick="SaveApplication" PreviewMouseRightButtonDown="CopyLocation" d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,0,4,4" ScrollViewer.ScrollChanged="ListViewScrollViewer_ScrollChanged">
                <!-- 模板来源：https://github.com/dotnet/wpf/blob/main/src/Microsoft.DotNet.Wpf/src/Themes/XAML/ListViewItem.xaml -->
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                        <Setter Property="VerticalContentAlignment" Value="Center"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="SnapsToDevicePixels" Value="True"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="5,2,5,2"/>
                        <Setter Property="Margin" Value="0,0,0,1"/>
                        <Setter Property="FocusVisualStyle">
                            <Setter.Value>
                                <Style TargetType="Control">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate>
                                                <Rectangle StrokeThickness="1" RadiusX="2" RadiusY="2" Stroke="#FF9E9E9E"/>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListViewItem">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}" CornerRadius="2" SnapsToDevicePixels="True">
                                        <GridViewRowPresenter VerticalAlignment="{TemplateBinding VerticalContentAlignment}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListItemHoverBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ListItemHoverBrush}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListItemSelectedBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ListItemSelectedBrush}"/>
                                        </Trigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True"/>
                                                <Condition Property="Selector.IsSelectionActive" Value="False"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListItemSelectedInactiveBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ListItemSelectedInactiveBrush}"/>
                                        </MultiTrigger>
                                        <MultiTrigger>
                                            <MultiTrigger.Conditions>
                                                <Condition Property="IsSelected" Value="True"/>
                                                <Condition Property="IsMouseOver" Value="True"/>
                                            </MultiTrigger.Conditions>
                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource ListItemSelectedHoverBrush}"/>
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource ListItemSelectedHoverBrush}"/>
                                        </MultiTrigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling"/>
                    </ItemsPanelTemplate>
                </ListView.ItemsPanel>

                <ListView.View>
                    <GridView ColumnHeaderContainerStyle="{DynamicResource LeftAlignedHeader}">
                        <GridViewColumn Width="250" Header="应用名称">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" ToolTip="右键项目复制所在文件夹地址">
                                        <Image Width="16" Height="16" Source="{Binding Icon, IsAsync=True}"/>
                                        <TextBlock VerticalAlignment="Center" Margin="10,0,0,0" helpers:TextBlockHelper.Highlight="{Binding NameAndSearchText}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>

                        <GridViewColumn Width="350" Header="地址">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock ToolTip="右键项目复制所在文件夹地址" helpers:TextBlockHelper.Highlight="{Binding TagAndSearchText}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
            <!-- 垂直滚动条 -->
            <ScrollBar Name="VerticalScrollBar" Orientation="Vertical" Visibility="Visible" HorizontalAlignment="Right" Margin="0,22,0,5" ValueChanged="VerticalScrollBar_ValueChanged"/>
            <!-- 水平滚动条 -->
            <ScrollBar Name="HorizontalScrollBar" Orientation="Horizontal" Visibility="Visible" VerticalAlignment="Bottom" Margin="1,0,12,1" ValueChanged="HorizontalScrollBar_ValueChanged"/>
        </Grid>
        <Button x:Name="SaveButton" Content="保存(S)" Style="{StaticResource BlueButton}" HorizontalAlignment="Right" Margin="0,0,70,14" VerticalAlignment="Bottom" Width="60" IsEnabled="False" Height="28" Click="SaveApp"/>
        <Button Content="取消" Style="{StaticResource WhiteButton}" HorizontalAlignment="Right" Margin="0,0,15,14" VerticalAlignment="Bottom" Width="45" Click="CloseThisWindow" Height="27.5"/>
    </Grid>
</Window>