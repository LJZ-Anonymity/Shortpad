<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <SolidColorBrush x:Key="TextColor" Color="Black"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PopupSurfaceBrush" Color="#FFF"/>
    <SolidColorBrush x:Key="PopupHighlightedItemBrush" Color="#EAEAEA"/>
    
    <!-- 设置窗口 -->
    <SolidColorBrush x:Key="MainStackPanelBrush" Color="#FFE0E0E0"/>
    <SolidColorBrush x:Key="MenuGridBrush" Color="#FFF0F0F0"/>

    <SolidColorBrush x:Key="Button1HoverBrush" Color="#FFF4F4F4"/>
    <SolidColorBrush x:Key="Button2HoverBrush" Color="#FFFAFAFA"/>
    
    <!-- 按钮 -->
    <SolidColorBrush x:Key="WhiteButtonBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="WhiteButtonBorderBrush" Color="#FFD5D5D5"/>
    <SolidColorBrush x:Key="WhiteButtonHoverBrush" Color="#FFF3F3F3"/>
</ResourceDictionary>