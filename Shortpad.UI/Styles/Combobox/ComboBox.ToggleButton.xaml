<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <!--
        ComboBox 的下拉按钮模板（显示选中项 + 箭头）。
        选中项直接绑定 ComboBox.SelectionBoxItem，由 WPF 原生处理内容、
        ItemTemplate 与 DisplayMemberPath，不需要克隆。
    -->
    <ControlTemplate x:Key="ComboBox.ToggleButtonTemplate" TargetType="ToggleButton">
        <Grid>
            <Border x:Name="border" Background="{DynamicResource ComboBoxBackgroundBrush}" BorderBrush="{DynamicResource ComboBoxBorderBrush}" BorderThickness="1" CornerRadius="3" Padding="5,0">
                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" Content="{Binding SelectionBoxItem, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" ContentTemplate="{Binding SelectionBoxItemTemplate, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" ContentStringFormat="{Binding SelectionBoxItemStringFormat, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}"/>
            </Border>
            <Path x:Name="arrow" Data="M0,0 L4,4 L8,0" Stroke="{DynamicResource ComboBoxArrowBrush}" Width="10" Height="6" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"/>
        </Grid>
        <ControlTemplate.Triggers>
            <!-- 鼠标悬停：边框与箭头切到悬停色 -->
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource ComboBoxBorderHoverBrush}"/>
                <Setter Property="Stroke" TargetName="arrow" Value="{DynamicResource ComboBoxArrowHoverBrush}"/>
            </Trigger>
            <!-- 下拉展开：边框使用强调色，箭头保持常态灰色并朝上 -->
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource ComboBoxAccentBrush}"/>
                <Setter Property="Stroke" TargetName="arrow" Value="{DynamicResource ComboBoxArrowBrush}"/>
                <Setter Property="Data" TargetName="arrow" Value="M0,4 L4,0 L8,4"/>
            </Trigger>
            <!-- 没有选项时隐藏箭头 -->
            <DataTrigger Binding="{Binding Path=HasItems, RelativeSource={RelativeSource AncestorType={x:Type ComboBox}}}" Value="false">
                <Setter Property="Visibility" TargetName="arrow" Value="Collapsed"/>
            </DataTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
</ResourceDictionary>