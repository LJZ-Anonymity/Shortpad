<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <!-- 按钮颜色 -->
    <Color x:Key="WhiteButtonBorderColor">#FF3F3F45</Color>
    <SolidColorBrush x:Key="TextBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202124"/>
    <SolidColorBrush x:Key="PopupSurfaceBrush" Color="#303030"/>
    <SolidColorBrush x:Key="PopupHighlightedItemBrush" Color="#454545"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource WhiteButtonBorderColor}"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#BABBBB"/>

    <!-- 设置窗口 -->
    <SolidColorBrush x:Key="MainStackPanelBrush" Color="#FF3A3A3A"/>
    <SolidColorBrush x:Key="MenuGridBrush" Color="#FF2A2A2A"/>

    <SolidColorBrush x:Key="Button1HoverBrush" Color="#FF2B2B2B"/>
    <SolidColorBrush x:Key="Button2HoverBrush" Color="#FF1F1F1F"/>

    <!-- 按钮 -->
    <SolidColorBrush x:Key="WhiteButtonBrush" Color="#FF1C1C1C"/>
    <SolidColorBrush x:Key="WhiteButtonBorderBrush" Color="{StaticResource WhiteButtonBorderColor}"/>
    <SolidColorBrush x:Key="WhiteButtonHoverBrush" Color="#FF2B2B2F"/>
</ResourceDictionary>