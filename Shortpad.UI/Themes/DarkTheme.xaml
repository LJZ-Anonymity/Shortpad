<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Color x:Key="BorderColor">#FF3F3F45</Color>
    <Color x:Key="ShadowEffectBrush">#FF2A2B2E</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="3A3A3AColor">#FF3A3A3A</Color>
    <Color x:Key="2D2D2DColor">#FF2D2D2D</Color>
    <Color x:Key="2B2B2BColor">#FF2B2B2B</Color>
    <Color x:Key="AccentColor">#FF4D7CF7</Color>
    <Color x:Key="383838Color">#FF383838</Color>
    <Color x:Key="454545Color">#FF454545</Color>

    <SolidColorBrush x:Key="TextBrush" Color="#E0E0E0"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#202124"/>
    <SolidColorBrush x:Key="PopupSurfaceBrush" Color="#303030"/>
    <SolidColorBrush x:Key="PopupHighlightedItemBrush" Color="{StaticResource 454545Color}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#BABBBB"/>
    <SolidColorBrush x:Key="SliderBrush" Color="{StaticResource BorderColor}"/>

    <!-- 查找应用窗口 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFECECEC"/>
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="{StaticResource 2D2D2DColor}"/>
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="{StaticResource 3A3A3AColor}"/>
    <SolidColorBrush x:Key="ListHeaderHoverBrush" Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="ListItemSelectedInactiveBrush" Color="#FF303030"/>
    <SolidColorBrush x:Key="ListItemSelectedHoverBrush" Color="{StaticResource 454545Color}"/>

    <!-- 搜索窗口 -->
    <SolidColorBrush x:Key="SearchBoxForegroundBrush" Color="{StaticResource WhiteColor}"/>
    <SolidColorBrush x:Key="SearchBoxPlaceholderBrush" Color="#FF9E9E9E"/>
    <SolidColorBrush x:Key="PinButtonHoverBrush" Color="{StaticResource 3A3A3AColor}"/>

    <!-- 设置窗口 -->
    <SolidColorBrush x:Key="MainStackPanelBrush" Color="{StaticResource 3A3A3AColor}"/>
    <SolidColorBrush x:Key="MenuGridBrush" Color="#FF2A2A2A"/>
    <SolidColorBrush x:Key="Button1HoverBrush" Color="{StaticResource 2B2B2BColor}"/>
    <SolidColorBrush x:Key="Button2HoverBrush" Color="#FF1F1F1F"/>

    <!-- 按钮 -->
    <SolidColorBrush x:Key="ButtonBrush" Color="#FF1C1C1C"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FF2B2B2F"/>

    <!-- 场景Button -->
    <SolidColorBrush x:Key="CheckedHoverSceneButtonBrush" Color="#FF434343"/>
    <SolidColorBrush x:Key="CheckedSceneButtonBrush" Color="{StaticResource 383838Color}"/>
    <SolidColorBrush x:Key="HoverSceneButtonBrush" Color="{StaticResource 2D2D2DColor}"/>

    <!-- 搜索Button -->
    <SolidColorBrush x:Key="SearchButtonHoverBrush" Color="#FF2F3136"/>

    <!-- ComboBox 专属键 -->
    <SolidColorBrush x:Key="ComboBoxBackgroundBrush" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="#FF46464C"/>
    <SolidColorBrush x:Key="ComboBoxBorderHoverBrush" Color="#FF5E5E64"/>
    <SolidColorBrush x:Key="ComboBoxAccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="ComboBoxArrowBrush" Color="#FF8C8C92"/>
    <SolidColorBrush x:Key="ComboBoxArrowHoverBrush" Color="#FFD0D0D4"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBackgroundBrush" Color="#FF2A2A2D"/>
    <SolidColorBrush x:Key="ComboBoxItemHoverBrush" Color="{StaticResource 383838Color}"/>
    <SolidColorBrush x:Key="ComboBoxItemSelectedBrush" Color="#FF3A3A3E"/>
    <SolidColorBrush x:Key="ComboBoxDisabledForegroundBrush" Color="#FF6B6B70"/>
    <SolidColorBrush x:Key="ComboBoxDisabledBackgroundBrush" Color="#FF242427"/>
    <Color x:Key="ComboBoxShadowColor">#000000</Color>

    <!-- CheckBox 专属键 -->
    <SolidColorBrush x:Key="CheckBoxBackgroundBrush" Color="#FF2D2D30"/>
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="#FF6A6A70"/>
    <SolidColorBrush x:Key="CheckBoxBorderHoverBrush" Color="#FF8A8A90"/>
    <SolidColorBrush x:Key="CheckBoxCheckedBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckMarkBrush" Color="{StaticResource WhiteColor}"/>
</ResourceDictionary>