<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Color x:Key="BorderColor">#FFD5D5D5</Color>
    <SolidColorBrush x:Key="TextBrush" Color="Black"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PopupSurfaceBrush" Color="#FFF"/>
    <SolidColorBrush x:Key="PopupHighlightedItemBrush" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="Gray"/>
    <SolidColorBrush x:Key="SliderBrush" Color="{StaticResource BorderColor}"/>

    <!-- 设置窗口 -->
    <SolidColorBrush x:Key="MainStackPanelBrush" Color="#FFE0E0E0"/>
    <SolidColorBrush x:Key="MenuGridBrush" Color="#FFF0F0F0"/>

    <SolidColorBrush x:Key="Button1HoverBrush" Color="#FFF4F4F4"/>
    <SolidColorBrush x:Key="Button2HoverBrush" Color="#FFFAFAFA"/>
    
    <!-- 按钮 -->
    <!-- 圆角Button -->
    <SolidColorBrush x:Key="ButtonBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FFF3F3F3"/>

    <!-- 场景Button -->
    <SolidColorBrush x:Key="CheckedHoverSceneButtonBrush" Color="#FFDFDFDF"/>
    <SolidColorBrush x:Key="CheckedSceneButtonBrush" Color="#FFE9E9E9"/>
    <SolidColorBrush x:Key="HoverSceneButtonBrush" Color="#FFF5F5F5"/>
</ResourceDictionary>