<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
>
    <Color x:Key="BorderColor">#FFD5D5D5</Color>
    <Color x:Key="ShadowEffectBrush">#FFBBBBBB</Color>
    <Color x:Key="WhiteColor">#FFFFFFFF</Color>
    <Color x:Key="D3Color">#FFD3D3D3</Color>
    <Color x:Key="5BColor">#FF5B5B5B</Color>
    <Color x:Key="AccentColor">#FF326CF3</Color>
    <Color x:Key="FAFAColor">#FFFAFAFA</Color>
    <Color x:Key="F4F4Color">#FFF4F4F4</Color>
    <Color x:Key="ABADB3Color">#FFABADB3</Color>

    <SolidColorBrush x:Key="TextBrush" Color="Black"/>
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource WhiteColor}"/>
    <SolidColorBrush x:Key="PopupSurfaceBrush" Color="{StaticResource WhiteColor}"/>
    <SolidColorBrush x:Key="PopupHighlightedItemBrush" Color="#EAEAEA"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="Gray"/>
    <SolidColorBrush x:Key="SliderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="ImageBrush" Color="Black"/>

    <!-- 查找应用窗口 -->
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FF1F1F1F"/>
    <SolidColorBrush x:Key="ListItemHoverBrush" Color="#FFF2F2F2"/>
    <SolidColorBrush x:Key="ListItemSelectedBrush" Color="#FFDDDDDD"/>
    <SolidColorBrush x:Key="ListHeaderHoverBrush" Color="#14000000"/>
    <SolidColorBrush x:Key="ListItemSelectedInactiveBrush" Color="#FFE8E8E8"/>
    <SolidColorBrush x:Key="ListItemSelectedHoverBrush" Color="{StaticResource D3Color}"/>

    <!-- 搜索窗口 -->
    <SolidColorBrush x:Key="SearchBoxForegroundBrush" Color="#FF000000"/>
    <SolidColorBrush x:Key="SearchBoxPlaceholderBrush" Color="{StaticResource D3Color}"/>
    <SolidColorBrush x:Key="PinButtonHoverBrush" Color="#FFEFEFEF"/>

    <!-- 设置窗口 -->
    <SolidColorBrush x:Key="MainStackPanelBrush" Color="#FFE0E0E0"/>
    <SolidColorBrush x:Key="MenuGridBrush" Color="#FFF0F0F0"/>
    <SolidColorBrush x:Key="Button1HoverBrush" Color="{StaticResource F4F4Color}"/>
    <SolidColorBrush x:Key="Button2HoverBrush" Color="{StaticResource FAFAColor}"/>

    <!-- 按钮 -->
    <SolidColorBrush x:Key="ButtonBrush" Color="{StaticResource WhiteColor}"/>
    <SolidColorBrush x:Key="ButtonBorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FFF3F3F3"/>

    <!-- 场景Button -->
    <SolidColorBrush x:Key="CheckedHoverSceneButtonBrush" Color="#FFDFDFDF"/>
    <SolidColorBrush x:Key="CheckedSceneButtonBrush" Color="#FFE9E9E9"/>
    <SolidColorBrush x:Key="HoverSceneButtonBrush" Color="#FFF5F5F5"/>

    <!-- 搜索Button -->
    <SolidColorBrush x:Key="SearchButtonHoverBrush" Color="#FFEEEEEE"/>

    <!-- ComboBox 专属键 -->
    <SolidColorBrush x:Key="ComboBoxBackgroundBrush" Color="{StaticResource FAFAColor}"/>
    <SolidColorBrush x:Key="ComboBoxBorderBrush" Color="{StaticResource ABADB3Color}"/>
    <SolidColorBrush x:Key="ComboBoxBorderHoverBrush" Color="{StaticResource 5BColor}"/>
    <SolidColorBrush x:Key="ComboBoxAccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="ComboBoxArrowBrush" Color="{StaticResource ABADB3Color}"/>
    <SolidColorBrush x:Key="ComboBoxArrowHoverBrush" Color="{StaticResource 5BColor}"/>
    <SolidColorBrush x:Key="ComboBoxDropDownBackgroundBrush" Color="{StaticResource WhiteColor}"/>
    <SolidColorBrush x:Key="ComboBoxItemHoverBrush" Color="#FFE6E6E6"/>
    <SolidColorBrush x:Key="ComboBoxItemSelectedBrush" Color="#FFD9D9D9"/>
    <SolidColorBrush x:Key="ComboBoxDisabledForegroundBrush" Color="#FF808080"/>
    <SolidColorBrush x:Key="ComboBoxDisabledBackgroundBrush" Color="{StaticResource F4F4Color}"/>
    <Color x:Key="ComboBoxShadowColor">#22000000</Color>

    <!-- CheckBox 专属键 -->
    <SolidColorBrush x:Key="CheckBoxBackgroundBrush" Color="{StaticResource WhiteColor}"/>
    <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="{StaticResource D3Color}"/>
    <SolidColorBrush x:Key="CheckBoxBorderHoverBrush" Color="{StaticResource 5BColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckedBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="CheckBoxCheckMarkBrush" Color="{StaticResource WhiteColor}"/>
</ResourceDictionary>